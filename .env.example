# Server Configuration
NODE_ENV=development
PORT=3007

# Database Configuration (PostgreSQL - Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/yebomart?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp Business API (for daily reports)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER=your-whatsapp-business-number

# YeboLink comms gateway (customer statements / payment reminders + daily
# WhatsApp reports / low-stock alerts via SMS+WhatsApp)
YEBOLINK_API_KEY=ybk_your-yebolink-api-key
# YEBOLINK_API_URL=https://api.yebolink.com  # optional; defaults to prod

# YeboPay payments gateway. yebomart is pay-as-you-go: the shop's credit
# balance and its ledger live in yebopay's wallet (keyed on the owner's YeboID
# sub), NOT in this database. Required by src/services/yebopay.client.ts —
# without it every billing endpoint throws.
#
# Key scopes needed:
#   wallet.read     — balance + ledger (GET /wallet/v1/balance, /transactions)
#   charges.write   — per-action credit debits (AI, comms)
#   checkouts.write — credit-pack top-up checkouts
#   wallet.write    — admin credit adjustments (POST /wallet/v1/adjustments).
#                     Admin-granted only via yebopay's /admin/merchants; a
#                     merchant cannot self-issue it. Without this scope the
#                     admin console can still VIEW billing but adjustments 403.
YEBOPAY_API_KEY=ypk_your-yebopay-api-key
# YEBOPAY_BASE_URL=https://api.yebopay.com  # optional; defaults to prod Cloud Run URL

# Shared secret for POST /api/internal/notifications/run (Cloud Scheduler → daily
# notification pass). Sent in the X-Internal-Secret header.
INTERNAL_NOTIFICATIONS_SECRET=change-me-internal-secret

# License Validation
LICENSE_SECRET=your-license-secret-key
